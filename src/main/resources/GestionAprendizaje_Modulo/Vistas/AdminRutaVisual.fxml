<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="640.0" prefWidth="360.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GestionAprendizaje_Modulo.Controladores.AdminRutaVisualController">
   <top>
      <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #F0F0F0; -fx-border-color: #D0D0D0; -fx-border-width: 0 0 1 0;">
         <children>
            <Label text="Panel de Administración">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            <ComboBox fx:id="comboCursos" onAction="#onCursoSeleccionado" prefWidth="320.0" promptText="Seleccionar o Crear Curso..." />
            <Button fx:id="btnNuevoCurso" mnemonicParsing="false" onAction="#handleNuevoCurso" prefWidth="320.0" text="Crear Curso Nuevo" />
            <ComboBox fx:id="comboRutas" onAction="#onRutaSeleccionada" prefWidth="320.0" promptText="Seleccionar o Crear Ruta..." />
            <Button fx:id="btnNuevaRuta" mnemonicParsing="false" onAction="#handleNuevaRuta" prefWidth="320.0" text="Crear Ruta para este Curso" />
         </children>
         <padding>
            <Insets bottom="15.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" BorderPane.alignment="CENTER">
         <content>
            <VBox fx:id="pathContainer" alignment="TOP_CENTER" spacing="15.0">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>